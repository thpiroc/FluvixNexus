# ---- Dependencies ----
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/releases

# ---- Build output ----
# electron-vite の出力先 (package.json main が参照)
out/
dist/
dist-electron/
build/
# electron-builder / パッケージング成果物
release/
*.asar
*.exe
*.msi
*.nsis
*.appx
*.blockmap

# ---- Caches ----
.vite/
.cache/
.temp/
.eslintcache
*.tsbuildinfo

# ---- Test / coverage ----
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
.vitest-cache/

# ---- Logs ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---- 環境変数 / 秘密情報 ----
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
*.keystore
*.jks
secrets.json
# フィードバックの保存先の設定（Notion の token など。本来は %APPDATA% に置くもの）
feedback-destinations.json
# Windows コード署名関連
certificate.*
codesign.*

# ---- ローカル環境固有 ----
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json
.vscode/.debug.env
.idea/
*.swp
*.swo
*.sublime-workspace

# Claude Code のローカル設定 (マシン固有のため共有しない)
.claude/settings.local.json

# ---- OS 生成ファイル ----
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# ---- 一時ファイル ----
tmp/
temp/
*.tmp
*.bak
*.orig
